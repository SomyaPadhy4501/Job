{
  "manifest_version": 3,
  "name": "Job Board Capture",
  "version": "1.22.0",
  "description": "Sends the job listings a careers page loads to your own job board, and fills job applications, sign-ups and emailed codes from your profile. Personal use; load unpacked.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Job Board Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "application-pages.js",
        "extract.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "application-pages.js",
        "autofill-fields.js",
        "autofill-adapters.js",
        "autofill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "exclude_matches": [
        "https://mail.google.com/*",
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://calendar.google.com/*",
        "https://www.google.com/*",
        "https://www.youtube.com/*",
        "https://github.com/*",
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.glassdoor.com/*",
        "https://*.vercel.app/*"
      ]
    },
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*"
      ],
      "js": [
        "autofill-login.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://mail.google.com/*",
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://calendar.google.com/*",
        "https://www.google.com/*",
        "https://www.youtube.com/*",
        "https://github.com/*",
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.glassdoor.com/*",
        "https://*.vercel.app/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*"
      ],
      "js": [
        "application-pages.js",
        "autofill-account.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "application-pages.js",
        "autofill-codes.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "exclude_matches": [
        "https://mail.google.com/*",
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://calendar.google.com/*",
        "https://www.google.com/*",
        "https://www.youtube.com/*",
        "https://github.com/*",
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.glassdoor.com/*",
        "https://*.vercel.app/*"
      ]
    }
  ],
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
