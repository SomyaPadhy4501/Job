{
  "name": "job-aggregator",
  "version": "1.0.0",
  "description": "Aggregates US software engineering jobs from Greenhouse, Lever, and Ashby with visa sponsorship classification.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "collect": "node --env-file-if-exists=.env src/scripts/collect-once.js",
    "tags:mina": "node --env-file-if-exists=.env src/scripts/preview-tags.js test/tag-examples.json data/tag-preview.json --model",
    "init-db": "node src/scripts/init-db.js",
    "reclassify": "node src/scripts/reclassify-sponsorship.js",
    "backfill-derived": "node src/scripts/backfill-derived.js",
    "test": "node --test"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.15"
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
